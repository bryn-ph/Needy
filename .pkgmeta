package-as: Needy

# The addon lives in Needy/ so the repo root can hold tooling; lift it to the top of the package.
move-folders:
  Needy/Needy: Needy

ignore:
  - README.md
  - LICENSE
  - CHANGELOG.md
  - CONTRIBUTING.md
  - requirements-dev.txt
  - tools
  - assets
  - tests

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown
